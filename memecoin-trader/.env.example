# ===========================================================================
# memecoin-trader - asetukset
# Kopioi tama tiedostoksi ".env" ja tayta arvot. ALA KOSKAAN commitoi .env-
# tiedostoa gittiin (juuren .gitignore jo estaa taman .env*-saannolla).
# ===========================================================================

# --- Solana RPC ---
# Julkinen mainnet-beta-RPC on hidas ja rajoittaa pyyntoja voimakkaasti.
# Botille suositellaan omaa RPC-avainta esim. Heliuksesta (ilmainen taso
# riittaa alkuun): https://www.helius.dev
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Lompakko ---
# Yksityinen avain base58-muodossa. Vie se Phantomista:
#   Asetukset -> Turvallisuus ja tietosuoja -> Nayta yksityinen avain
# ALA JAA TATA KENELLEKAAN. Kayta mieluiten erillista "botti-lompakkoa",
# johon siirrat vain sen summan rahaa jonka olet valmis haviamaan kokonaan.
WALLET_PRIVATE_KEY=

# --- Turvakytkin ---
# false = paperikauppa (simulaatio virtuaalisalkulla, ei oikeaa rahaa liikkeella)
# true  = OIKEAT KAUPAT OIKEALLA RAHALLA
# Aloita AINA arvolla false ja seuraa botin paatoksia ennen kuin vaihdat true:ksi.
LIVE_TRADING=false

# --- Paperikauppa ---
# Virtuaalisalkun aloitussaldo kun LIVE_TRADING=false. Ei koske oikeaa
# lompakkoa - taman ansiosta paperikauppaa voi testata ilman
# WALLET_PRIVATE_KEY:ta ja ilman oikeaa SOL:aa.
PAPER_STARTING_BALANCE_SOL=1

# --- Riskienhallinta ---
MAX_POSITION_SOL=0.05          # max SOL yhta positiota (yhta ostoa) kohden
MAX_CONCURRENT_POSITIONS=3     # max avoinna olevien positioiden maara yhta aikaa
MAX_DAILY_LOSS_SOL=0.2         # jos paivan realisoidut tappiot ylittavat taman, botti pysahtyy loppupaivaksi
TAKE_PROFIT_PCT=40             # myy kun voitto ylittaa taman %
STOP_LOSS_PCT=15               # myy kun tappio ylittaa taman %
TRAILING_STOP_PCT=10           # myy jos hinta laskee taman % position aikaisesta huipusta (ATH)
MAX_HOLD_MINUTES=180           # pakkomyynti taman ajan jalkeen, vaikka mikaan raja ei olisi lauennut
MIN_LIQUIDITY_USD=15000        # ohita tokenit joiden poolin likviditeetti on tata pienempi
MIN_PAIR_AGE_MINUTES=10        # ohita juuri listatut parit (suurin huijaus-/rugpull-riski heti listautuessa)
MAX_SLIPPAGE_BPS=300           # 300 = 3% max slippage swapissa
BUY_SCORE_THRESHOLD=0.62       # oppivan mallin pisteraja (0-1) jonka ylittava token ostetaan
SELL_SCORE_THRESHOLD=0.35      # jos mallin pisteet putoavat talle tasolle, myydaan vaikka SL/TP ei ole lauennut

# --- Skannaus ---
SCAN_INTERVAL_SECONDS=45       # kuinka usein botti kayn kierroksen (markkinadata + paatokset)
DEXSCREENER_CHAIN=solana

# --- Copy-trading (valinnainen) ---
# Pilkulla erotettu lista Solana-lompakko-osoitteita joita seurataan. Jos
# jokin naista pitaa hallussaan/alkaa pitaa hallussaan botin skannaamaa
# tokenia, se nostaa kyseisen tokenin pisteita oppivassa mallissa - mutta EI
# ohita likviditeetti-/ika-/turvasuodattimia eika riskirajoja. Malli oppii
# ajan myota itse kuinka paljon tahan signaaliin kannattaa luottaa.
# Tyhjana (oletus) ominaisuus ei tee mitaan.
# HUOM: tama on POLLAAVA (ei reaaliaikainen) toteutus - havaitseminen viivastyy
# aina jonkin verran, mika on olennainen riski copy-tradingissa ylipaataan.
WATCHED_WALLETS=

# --- X (Twitter) -signaali (valinnainen) ---
# Seuraa antamiasi X-tileja (esim. vaikutusvaltaisia henkiloita) ja nostaa
# niiden tuoreiden, kryptoon/tiettyyn tokeniin viittaavien twiittien mukaan
# osuvien kandidaattien pisteita oppivassa mallissa - EI ohita suodattimia
# eika riskirajoja, sama periaate kuin copy-tradingissa.
# Tyhjana (oletus, TWITTER_BEARER_TOKEN tyhja) ominaisuus ei tee mitaan.
#
# VAATII oman X-kehittajatilin: developer.x.com -> luo App -> Bearer Token.
# Helmikuusta 2026 alkaen X:n oletushinnoittelu on "pay-per-use" (n. 0.005$
# per luettu twiitti, ei enaa pakollista 200$/kk-tilausta uusille kehitta-
# jille) - aseta silti kulukatto X:n kehittajapaneelista, jottei laskutus
# karkaa kasista. Katso README.
TWITTER_BEARER_TOKEN=
# Pilkulla erotettu lista kayttajatunnuksia ILMAN @-merkkia, esim: realDonaldTrump,elonmusk
TWITTER_WATCHED_HANDLES=
# Kuinka usein X:aa kysellaan - pidetaan harvempana kuin markkinaskannaus,
# koska jokainen kysely maksaa oikeaa rahaa.
TWITTER_POLL_INTERVAL_SECONDS=120

# --- Dashboard ---
PORT=3300
