# Kopioi tämä tiedosto nimelle ".env" samaan kansioon ja täytä oikeat arvot.
# ".env" on gitignoressa, joten se EI päädy koskaan GitHubiin.

# SQL Server -yhteyden tiedot (stodb, Win2022VM)
DB_SERVER=192.168.2.144
DB_DATABASE=stodb
DB_USER=mobileapi_user
DB_PASSWORD=CHANGE_ME

# Pitkä satunnainen merkkijono JWT-istuntotunnisteiden allekirjoitukseen.
# Generoi esim. PowerShellillä:
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 48|%{[char]$_})
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Portti, jossa API kuuntelee tässä lähiverkossa
PORT=3001

# Sallitut selainosoitteet (CORS). Pilkulla eroteltuna jos useampi.
# Kehityksessä Viten oletusosoite, tuotannossa esim. Vercel-osoite.
CORS_ORIGIN=http://localhost:5173
